{
  "configurations": [
    {
      "type": "cmake",
      "request": "launch",
      "name": "CMake: Configure project",
      "cmakeDebugType": "configure",
      "clean": false,
      "configureAll": false,
      "scriptArgs": [
        "-G=Xcode",
        "-S=${workspaceFolder}/example",
        "-B=${workspaceFolder}/build",
        "-DENABLE_COVERAGE=ON",
        "-DCOVERAGE_TOOL=llvm"
      ]
    },
    {
      "type": "cmake",
      "request": "launch",
      "name": "Build and Run Project",
      "cmakeDebugType": "configure",
      "clean": false,
      "configureAll": false,
      "scriptArgs": [
        "--build", "${workspaceFolder}/build", "--target", "generate_profile_data"
      ]
    },

    {
      "name": "Generate Profile Data",
      "type": "debugpy",
      "request": "launch",
      "program": "src/generate_profile.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        // "--help",
        "--test-binary=${workspaceFolder}/build/Debug/coverage_example",
        "--output-directory=${workspaceFolder}/build/coverage_example_output",
      ],
    }
  ]
}
